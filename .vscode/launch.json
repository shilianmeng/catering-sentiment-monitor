{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端 FastAPI (8091)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "YUQING_MYSQL_HOST": "127.0.0.1",
        "YUQING_MYSQL_PORT": "3306",
        "YUQING_MYSQL_USER": "root",
        "YUQING_MYSQL_PASSWORD": "root",
        "YUQING_MYSQL_DATABASE": "YuQing"
      },
      "justMyCode": true
    },
    {
      "name": "前端 Vue (5180)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:.*?(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "舆情平台：前后端一起启动",
      "configurations": [
        "后端 FastAPI (8091)",
        "前端 Vue (5180)"
      ],
      "stopAll": true
    }
  ]
}
