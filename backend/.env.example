# 复制成 backend/.env 后按需修改；.env 已被 .gitignore 排除，不会进版本库。
# 不建这个文件也能跑：默认连本机 MySQL(root/root)、不调大模型（走模板生成）。

# ---- MySQL ----
YUQING_MYSQL_HOST=127.0.0.1
YUQING_MYSQL_PORT=3306
YUQING_MYSQL_USER=root
YUQING_MYSQL_PASSWORD=root
YUQING_MYSQL_DATABASE=YuQing

# ---- 后端 ----
YUQING_HOST=127.0.0.1
YUQING_PORT=8091
# 平台名与品牌无关；品牌在页面「监测主题」里配置
YUQING_APP_NAME=餐饮舆情监测与研判平台

# ---- 大模型（可选）----
# 不填则报告与公关话术走模板生成，功能完整，只是文字不经过模型润色
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
